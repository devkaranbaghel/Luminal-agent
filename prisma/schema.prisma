generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// User / NextAuth Setup
// =======================
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  
  // Backend specific User fields
  passwordHash  String?
  role          String?   @default("Product Designer")
  location      String?   @default("San Francisco, CA")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]              // NextAuth Session
  refreshSessions RefreshSession[]     // JWT Refresh Sessions
  
  profile       Profile?
  applications  Application[]
  notifications Notification[]
  pipelineJobs   PipelineJob[]
  scrapingFilter ScrapingFilter?
  scraperLogs    ScraperLog[]
  interviews     Interview[]
  jobs          ScrapedJob[]         // Backend scraped jobs relation
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =======================
// Profile & Resumes
// =======================
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  email        String?
  headline     String?
  atsScore     Float?   @default(0)
  githubUrl    String?
  portfolioUrl String?
  skills       Skill[]
  experience   Experience[]
  education    Education[]
  projects     Project[]
  certificates Certificate[]
  resumes      ResumeVersion[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Skill {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  company     String
  period      String
  description String?
}

model Education {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school      String
  degree      String
  period      String
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?
  link        String?
}

model Certificate {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  issuer      String
  date        String
}

model ResumeVersion {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versionName String
  content     Json
  isMaster    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =======================
// Jobs & Filtering
// =======================
model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  logoUrl     String?
  location    String
  salary      String
  platform    String
  postedAt    String
  description String
  matchScore  Int
  skills      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  applications Application[]
}

model ScrapedJob {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String?
  matchScore  Int?
  status      String    @default("RANKED") // RANKED, DISCARDED
  source      String?   
  externalUrl String?   @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

model PipelineJob {
  id          String   @id @default(cuid())
  userId      String
  title       String
  company     String
  stage       String
  status      String?
  matchScore  Int?
  dateLabel   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScrapingFilter {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords     String   @default("React, TypeScript, Node.js")
  location     String   @default("Remote / India")
  jobTypes     String   @default("Full-time")
  minSalary    Int      @default(2800000)
  maxSalary    Int?
  minExperience Int     @default(5)
  updatedAt    DateTime @updatedAt
}

// =======================
// Applications & Logs
// =======================
model Application {
  id          String   @id @default(cuid())
  userId      String
  
  // Frontend original Job linked fields
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // Backend direct string fields
  jobTitle    String?
  company     String?
  location    String?
  appliedDate DateTime?
  
  status      String   @default("APPLIED") // APPLIED, SAVED, INTERVIEW, QUEUED, APPLYING, INTERVIEWing, REJECTED, OFFER
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs AgentLog[]
}

model AgentLog {
  id            String      @id @default(uuid())
  level         String      // INFO, SUCCESS, ERROR
  message       String
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime    @default(now())
}

model ScraperLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String
  message   String
  createdAt DateTime @default(now())
}

// =======================
// Notifications
// =======================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, AGENT
  source    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =======================
// Interviews
// =======================
model Interview {
  id          String   @id @default(cuid())
  userId      String
  company     String
  role        String
  scheduledAt DateTime?
  date        DateTime?
  status      String   @default("SCHEDULED")
  type        String   @default("Technical") // Screening, Technical, Onsite
  intelTags   String?  // JSON string: "['React', 'High Growth', 'Seed']"
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   PrepQuestion[]
}

model PrepQuestion {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question    String
  difficulty  String
  category    String
  practiceAttempts Int  @default(0)
}
